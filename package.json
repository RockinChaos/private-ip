{
  "name": "@rockinchaos/private-ip",
  "version": "3.1.0",
  "description": "Check if IP address is private.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./index.js"
    }
  },
  "type": "module",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockinChaos/private-ip.git"
  },
  "bugs": "https://github.com/RockinChaos/private-ip/issues",
  "homepage": "https://github.com/RockinChaos/private-ip#readme",
  "authors": [
    "Damir Mustafin <frenchthebread@gmail.com>",
    "Sick.Codes <https://twitter.com/sickcodes>",
    "John Jackson <https://twitter.com/johnjhacking>",
    "Nick Sahler <https://twitter.com/tensor_bodega>"
  ],
  "contributors": [
    {
      "name": "Harold Hunt",
      "url": "https://www.linkedin.com/in/huntharo/"
    },
    {
      "name": "Aravindha Hariharan M",
      "url": "https://www.linkedin.com/in/aravindha1234u/"
    },
    {
      "name": "RockinChaos",
      "url": "https://github.com/RockinChaos"
    }
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rimraf --glob ./lib",
    "build": "npm run clean && tsc --outDir lib",
    "test": "npm run build && ava",
    "prepublishOnly": "npm run build",
    "release": "npm publish --provenance --access public"
  },
  "keywords": [
    "ip",
    "ipv4",
    "ipv6",
    "address",
    "private",
    "netmask",
    "localhost",
    "lan"
  ],
  "devDependencies": {
    "@types/netmask": "^2.0.6",
    "ava": "^8.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@chainsafe/is-ip": "^2.1.0",
    "ip-regex": "^5.0.0",
    "ipaddr.js": "^2.4.0",
    "netmask": "^2.1.1"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "extensions": ["ts"],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
