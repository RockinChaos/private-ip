{
  "name": "@rockinchaos/private-ip",
  "version": "3.2.0",
  "description": "Check if IP address is private.",
  "packageManager": "pnpm@12.17.0",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./index.js"
    }
  },
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RockinChaos/private-ip.git"
  },
  "bugs": "https://github.com/RockinChaos/private-ip/issues",
  "homepage": "https://github.com/RockinChaos/private-ip#readme",
  "author": {
    "name": "RockinChaos",
    "url": "https://github.com/RockinChaos"
  },
  "contributors": [
    {
      "name": "Damir Mustafin",
      "email": "frenchthebread@gmail.com"
    },
    {
      "name": "Sick.Codes",
      "url": "https://twitter.com/sickcodes"
    },
    {
      "name": "John Jackson",
      "url": "https://twitter.com/johnjhacking"
    },
    {
      "name": "Nick Sahler",
      "url": "https://twitter.com/tensor_bodega"
    },
    {
      "name": "Harold Hunt",
      "url": "https://www.linkedin.com/in/huntharo/"
    },
    {
      "name": "Aravindha Hariharan M",
      "url": "https://www.linkedin.com/in/aravindha1234u/"
    }
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rimraf --glob ./lib",
    "build": "pnpm run clean && tsc --outDir lib",
    "test": "pnpm run build && ava",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm publish --access public"
  },
  "keywords": [
    "ip",
    "ipv4",
    "ipv6",
    "address",
    "private",
    "netmask",
    "localhost",
    "lan"
  ],
  "devDependencies": {
    "@types/netmask": "^2.0.6",
    "ava": "^8.4.0",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@chainsafe/is-ip": "^2.1.0",
    "ip-regex": "^5.0.0",
    "ipaddr.js": "^2.5.0",
    "netmask": "^2.1.1"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
